{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Standardrechte der App: Kern, Einstellungen (Store), Speichern-Dialog, HTTP zu HTTPS-Endpunkten und lokalen LLM-Servern sowie Start der nativen Stockfish-Engine (nur dieser Sidecar)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    "store:default",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/stockfish",
          "sidecar": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
