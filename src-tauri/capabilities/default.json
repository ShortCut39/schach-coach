{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Standardrechte der App: Kern, Einstellungen (Store) und HTTP zu beliebigen HTTPS-Endpunkten sowie lokalen LLM-Servern",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    "store:default",
    "dialog:allow-save"
  ]
}
